{
    "version": 2,
    "builds": [
      {
        "src": "/lib/fa/css/*",
        "use": "@vercel/static",
        "config": { "headers": { "Content-Type": "text/css" } }
      },
      {
        "src": "/build/*",
        "use": "@vercel/static",
        "config": { "headers": { "Content-Type": "text/css" } }
      }
    ],
    "routes": [
      {
        "src": "/favicon/(.*)",
        "dest": "/favicon/$1"
      },
      {
        "src": "/img/(.*)",
        "dest": "/img/$1"
      }
    ]
  }

  